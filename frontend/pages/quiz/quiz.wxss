page {
  background: #f4f7fb;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.header {
  flex-shrink: 0;
}

.paper-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.progress {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.loading,
.empty {
  margin-top: 80rpx;
  text-align: center;
  color: #6b7280;
  font-size: 28rpx;
}

.quiz-card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 24rpx rgba(16, 24, 40, 0.06);
  box-sizing: border-box;
  width: 100%;
}

.question {
  font-size: 32rpx;
  line-height: 1.5;
  color: #1f2937;
  font-weight: 600;
  margin-bottom: 22rpx;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.option-btn {
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  display: block;
  text-align: left;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.45;
  color: #111827;
  border: 1rpx solid #e5e7eb;
  background: #ffffff;
  border-radius: 14rpx;
  margin: 0;
}

.option-btn::after {
  border: 0;
}

.submit-btn {
  width: 100%;
  margin-top: 28rpx;
  border-radius: 14rpx;
}
