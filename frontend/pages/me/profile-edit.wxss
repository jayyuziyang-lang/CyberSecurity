.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 24rpx;
}

.avatar-wrap {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  margin-right: 20rpx;
  background: #f0f0f0;
}

.avatar-btn {
  margin: 0;
}

.field {
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.input {
  height: 84rpx;
  border: 1rpx solid #d8dee8;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #222;
}

.save-btn {
  margin-top: 8rpx;
}
