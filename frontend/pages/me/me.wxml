<view class="container">
  <view class="user-main-card" bindtap="handleLogin">
    <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
    <view class="user-info">
      <view class="nickname">{{userInfo.nickname || '点击登录'}}</view>
      <view class="user-id">ID: {{userInfo.id || '---'}}</view>
      <view class="status-info-row">
        <view class="status-item">
          <text class="status-num">{{userInfo.points || 0}}</text>
          <text class="status-label">积分</text>
        </view>
        <view class="status-divider"></view>
        <view class="status-item">
          <text class="status-num">{{userInfo.isAuthenticated ? '已认证' : '未认证'}}</text>
          <text class="status-label">认证状态</text>
        </view>
      </view>
    </view>
  </view>

  <view class="full-menu-list">
    <view class="full-menu-item" bindtap="goToDiagnosis">
      <text class="menu-text">学习诊断报告</text>
      <text class="menu-badge">智能</text>
      <text class="arrow">></text>
    </view>
    <view class="full-menu-item" bindtap="goToRank">
      <text class="menu-text">排行榜</text>
      <text class="arrow">></text>
    </view>
    <view class="full-menu-item" bindtap="goToWrongSet">
      <text class="menu-text">错题本</text>
      <text class="arrow">></text>
    </view>
    <view class="full-menu-item" bindtap="goToRealAuth">
      <text class="menu-text">实名认证</text>
      <text class="arrow">></text>
    </view>
    <view class="full-menu-item" bindtap="onFollowTap">
      <text class="menu-text">关注公众号</text>
      <text class="arrow">></text>
    </view>
    <view class="full-menu-item" bindtap="goToProfileEdit">
      <text class="menu-text">资料设置</text>
      <text class="arrow">></text>
    </view>
    <view class="full-menu-item" bindtap="goToReport">
      <text class="menu-text">一键举报</text>
      <text class="arrow">></text>
    </view>
  </view>

  <view class="full-menu-list" wx:if="{{role == 1}}">
    <view class="full-menu-item">
      <text class="menu-text">管理员控制台</text>
    </view>
    <view class="full-menu-item" bindtap="goToPublishNews">
      <text class="menu-text">发布资讯</text>
      <text class="arrow">></text>
    </view>
    <view class="full-menu-item" bindtap="goToQuizManager">
      <text class="menu-text">题目管理</text>
      <text class="arrow">></text>
    </view>
    <view class="full-menu-item" bindtap="goToReportManager">
      <text class="menu-text">举报审核</text>
      <text class="arrow">></text>
    </view>
    <view class="full-menu-item" bindtap="goToAdminDashboard">
      <text class="menu-text">数据看板</text>
      <text class="arrow">></text>
    </view>
  </view>
</view>
