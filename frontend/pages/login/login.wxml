<view class="page">
  <view class="card">
    <view class="title">{{isRegisterMode ? '用户注册' : '登录'}}</view>
    <view class="sub-title">网络安全信息平台</view>

    <view class="field">
      <view class="label">用户名</view>
      <input
        class="input"
        placeholder="请输入账号"
        data-field="username"
        value="{{username}}"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <view class="label">密码</view>
      <input
        class="input"
        password="true"
        placeholder="请输入密码"
        data-field="password"
        value="{{password}}"
        bindinput="onInput"
      />
    </view>

    <button
      wx:if="{{!isRegisterMode}}"
      class="login-btn"
      type="primary"
      loading="{{loading}}"
      bindtap="submitLogin"
    >登录</button>
    <button
      wx:else
      class="login-btn"
      type="primary"
      loading="{{loading}}"
      bindtap="submitRegister"
    >立即注册</button>

    <view class="mode-link" bindtap="switchMode">
      {{isRegisterMode ? '已有账号，返回登录' : '没有账号？立即注册'}}
    </view>
  </view>
</view>
