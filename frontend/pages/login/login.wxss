.page {
  min-height: 100vh;
  background: linear-gradient(160deg, #e8f4ff 0%, #f6fbff 100%);
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.card {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(18, 150, 219, 0.12);
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: #1f2937;
}

.sub-title {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
  margin-bottom: 30rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 12rpx;
}

.input {
  height: 82rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #111827;
  background: #fff;
}

.login-btn {
  margin-top: 16rpx;
}

.mode-link {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1296db;
}
