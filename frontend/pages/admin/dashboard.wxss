.page {
  min-height: 100vh;
  background: #f6f8fc;
  padding: 24rpx;
  box-sizing: border-box;
}

.empty {
  margin-top: 120rpx;
  text-align: center;
  color: #777;
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c2b49;
  line-height: 1.5;
}

.meta {
  margin-top: 12rpx;
  color: #1e8f5d;
  font-size: 28rpx;
}

.category {
  margin-top: 8rpx;
  color: #666;
  font-size: 24rpx;
}

.student-list {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #dbe1eb;
}

.student-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2d3b5f;
  margin-bottom: 8rpx;
}

.student-item {
  font-size: 25rpx;
  color: #444;
  margin-bottom: 6rpx;
}

.student-empty {
  font-size: 24rpx;
  color: #999;
}
