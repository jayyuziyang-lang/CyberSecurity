.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.input,
.picker {
  height: 80rpx;
  border: 1rpx solid #d8dee6;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333333;
  display: flex;
  align-items: center;
}

.textarea {
  width: 100%;
  height: 220rpx;
  border: 1rpx solid #d8dee6;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.textarea.small {
  height: 160rpx;
}

.submit-btn {
  margin-top: 20rpx;
}

.btn-row {
  margin-top: 20rpx;
  display: flex;
  gap: 20rpx;
}

.btn-row button {
  flex: 1;
  margin: 0;
}

.import-btn {
  background: #ff8f1f;
  color: #ffffff;
}
