<view class="page">
  <view class="card">
    <view class="title">{{title}}</view>
    <view class="meta">举报ID：{{id || '-'}}</view>
    <view class="meta">用户ID：{{userId}}</view>
    <view class="meta">提交时间：{{createTime}}</view>
    <view class="meta">审核状态：{{statusText}}</view>

    <view class="section-title">举报内容</view>
    <view class="content">{{content}}</view>
  </view>
</view>
