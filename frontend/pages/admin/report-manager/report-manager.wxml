<view class="page">
  <view class="toolbar">
    <text class="title">举报审核管理</text>
    <button class="refresh-btn" size="mini" bindtap="loadPendingReports">刷新</button>
  </view>

  <view wx:if="{{loading}}" class="status">加载中...</view>
  <view wx:elif="{{reportList.length === 0}}" class="status">暂无待审核举报</view>

  <view wx:for="{{reportList}}" wx:key="id" class="report-card">
    <view class="report-left">
      <view class="report-title">{{item.displayTitle}}</view>
      <view class="report-content">{{item.content}}</view>
      <view class="report-meta">举报ID：{{item.id}} · 用户ID：{{item.displayUserId}}</view>
      <view class="report-meta">提交时间：{{item.displayTime}}</view>
    </view>
    <view class="report-right">
      <button
        class="approve-btn"
        type="primary"
        size="mini"
        loading="{{approvingId === item.id}}"
        data-id="{{item.id}}"
        bindtap="approveReport"
      >审核并发布为公告</button>
    </view>
  </view>
</view>
