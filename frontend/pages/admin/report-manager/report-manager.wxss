.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2d4d;
}

.refresh-btn {
  margin: 0;
}

.status {
  margin-top: 120rpx;
  text-align: center;
  color: #7a8599;
  font-size: 28rpx;
}

.report-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.report-left {
  flex: 1;
}

.report-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d4d;
  line-height: 1.4;
}

.report-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.5;
}

.report-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.report-right {
  display: flex;
  align-items: center;
}

.approve-btn {
  margin: 0;
  font-size: 24rpx;
  padding: 0 16rpx;
  background: #0f766e;
}
