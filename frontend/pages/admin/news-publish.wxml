<view class="page">
  <view class="card">
    <view class="field">
      <view class="label">标题</view>
      <input class="input" placeholder="请输入标题" bindinput="onTitleInput" value="{{title}}" />
    </view>

    <view class="field">
      <view class="label">资讯分类</view>
      <picker mode="selector" range="{{categoryOptions}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker">{{categoryOptions[categoryIndex]}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">内容</view>
      <textarea
        class="textarea"
        placeholder="请输入内容"
        maxlength="-1"
        bindinput="onContentInput"
        value="{{content}}"
      ></textarea>
    </view>

    <button class="submit-btn" type="primary" bindtap="onSubmit">发布</button>
  </view>
</view>
