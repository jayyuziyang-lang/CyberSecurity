.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.paper-create-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d4d;
  margin-bottom: 12rpx;
}

.paper-create-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.paper-input {
  flex: 1;
  height: 72rpx;
  border: 1rpx solid #d8dee6;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
}

.create-btn {
  margin: 0;
}

.toolbar {
  margin: 20rpx 0;
}

.add-btn {
  margin: 0;
}

.status {
  color: #7a8599;
  text-align: center;
  margin-top: 80rpx;
  font-size: 28rpx;
}

.paper-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.paper-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
}

.paper-title {
  color: #1f2d4d;
  font-size: 30rpx;
  font-weight: 700;
}

.paper-count {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.paper-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mini-add {
  margin: 0;
  background: #2f7bff;
  color: #fff;
}

.arrow {
  color: #6b7280;
  font-size: 24rpx;
}

.quiz-list {
  border-top: 1rpx solid #eef1f5;
  padding: 16rpx 20rpx 20rpx;
}

.quiz-empty {
  color: #7a8599;
  font-size: 24rpx;
}

.quiz-item {
  background: #f9fbff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 12rpx;
}

.question {
  color: #1f2d4d;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.answer {
  margin-top: 8rpx;
  color: #2a7b47;
  font-size: 24rpx;
}

.actions {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
}

.btn {
  margin: 0;
}

.btn + .btn {
  margin-left: 12rpx;
}

.edit-btn {
  background: #2f7bff;
  color: #ffffff;
}

.del-btn {
  background: #e54d42;
  color: #ffffff;
}
