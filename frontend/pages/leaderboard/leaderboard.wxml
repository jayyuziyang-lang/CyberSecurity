<view class="container" style="padding: 20px; background-color: #f4f7f9; min-height: 100vh;">
  <view style="text-align: center; margin-bottom: 20px;">
    <view style="font-size: 24px; font-weight: bold; color: #1296db;">积分排行榜</view>
    <view style="font-size: 12px; color: #999; margin-top: 5px;">坚持学习，持续提升排名</view>
  </view>

  <view style="background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);">
    <block wx:for="{{rankList}}" wx:key="id">
      <view style="display: flex; align-items: center; padding: 15px; border-bottom: 1rpx solid #eee;">
        <view style="width: 40px; font-size: 18px; font-style: italic; font-weight: bold; color: {{index < 3 ? '#ff9800' : '#999'}};">
          {{index + 1}}
        </view>

        <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" style="width: 40px; height: 40px; border-radius: 50%; margin-right: 15px;"></image>
        <view wx:else style="width: 40px; height: 40px; border-radius: 50%; background: #e0e0e0; margin-right: 15px;"></view>

        <view style="flex: 1; font-size: 16px; color: #333;">{{item.username}}</view>

        <view style="font-weight: bold; color: #1296db;">{{item.points}} 分</view>
      </view>
    </block>

    <view wx:if="{{rankList.length === 0}}" style="padding: 40px; text-align: center; color: #ccc;">
      暂无排行数据
    </view>
  </view>
</view>
