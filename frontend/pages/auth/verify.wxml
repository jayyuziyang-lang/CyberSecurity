<view class="page">
  <view class="card">
    <view class="title">实名认证</view>
    <view class="desc">填写姓名和身份证号</view>

    <view class="field">
      <view class="label">姓名</view>
      <input
        class="input"
        placeholder="请输入真实姓名"
        data-field="realName"
        value="{{realName}}"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <view class="label">身份证号</view>
      <input
        class="input"
        placeholder="请输入18位身份证号"
        data-field="idCard"
        value="{{idCard}}"
        bindinput="onInput"
      />
    </view>

    <button class="submit-btn" type="primary" loading="{{loading}}" bindtap="submitVerify">提交认证</button>
  </view>
</view>
